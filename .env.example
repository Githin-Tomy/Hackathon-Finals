# ── GitHub PAT (simple / fallback mode) ──────────────────────────────────────
# Used only if GitHub App credentials below are NOT set.
# Comments will appear under YOUR personal GitHub username.
# Scopes: repo, read:org
GITHUB_TOKEN=ghp_your_github_pat_here

# ── GitHub App (bot identity — RECOMMENDED) ───────────────────────────────────
# When configured, review comments appear as "your-app-name[bot]" instead of
# your personal username. Follow the setup guide in README.md to create the app.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
# Paste the FULL contents of your downloaded .pem private key on ONE line,
# replacing real newlines with \n  (see README for how to do this on Windows)
GITHUB_APP_PRIVATE_KEY=

# ── Webhook ───────────────────────────────────────────────────────────────────
# Must match the secret you set when creating the GitHub webhook
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# ── Smee.io Webhook Forwarder ─────────────────────────────────────────────────
# Go to https://smee.io/, click "Start a new channel", paste the URL here
SMEE_URL=https://smee.io/your_smee_channel_id_here

# ── OpenAI / Custom GPT LLM ───────────────────────────────────────────────────
# Your API key from your OpenAI provider or Custom Gateway
OPENAI_API_KEY=your_openai_api_key_here

# Model name (e.g. gpt-3.5-turbo, gpt-4o, gpt-4o-mini)
OPENAI_MODEL=gpt-3.5-turbo

# Custom Base URL endpoint (e.g. https://genailab.tcs.in)
OPENAI_BASE_URL=https://genailab.tcs.in

# Temperature (0.0 = deterministic, 0.1 recommended for code review)
OPENAI_TEMPERATURE=0.1

# ── App ───────────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./code_review.db
CONFIDENCE_THRESHOLD=0.95
APP_PORT=8000
ENVIRONMENT=development
